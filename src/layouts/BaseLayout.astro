---
import "../styles/global.css";

interface Props {
    lang: "en" | "de";
    title: string;
    description: string;
}

const {
    lang,
    title,
    description,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta
            name="description"
            content={description}
        />

        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
    </head>

    <body>
        <a class="skip-link" href="#main-content">
            {lang === "de" ? "Zum Inhalt" : "Skip to content"}
        </a>

        <slot />
    </body>
</html>